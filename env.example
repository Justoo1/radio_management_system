# Database
DATABASE_URL="postgresql://user:password@localhost:5432/radio_management"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Payment - Hubtel (Ghana Mobile Money)
HUBTEL_CLIENT_ID="your-hubtel-client-id"
HUBTEL_CLIENT_SECRET="your-hubtel-client-secret"
HUBTEL_MERCHANT_NUMBER="your-merchant-number"

# SMS Gateway
SMS_PROVIDER="hubtel" # or "africas-talking"
SMS_API_KEY="your-sms-api-key"

# File Storage - AWS S3
STORAGE_PROVIDER="s3" # or "cloudinary"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="eu-west-1"
AWS_BUCKET_NAME="your-bucket-name"

# Alternative: Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Service - Resend
RESEND_API_KEY="your-resend-api-key"

# Application
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Logging
LOG_LEVEL="debug"

# Feature Flags
ENABLE_STRIPE=false
ENABLE_STRIPE_TEST=true
ENABLE_SMS=true
ENABLE_EMAIL=true
