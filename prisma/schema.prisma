enum ListenerPlatform {
  WEB
  MOBILE_APP
  SMART_SPEAKER
  CAR_RADIO
  THIRD_PARTY
}

model ListenerMetrics {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Time bucket
  timestamp DateTime
  hour      Int // 0-23
  dayOfWeek Int // 0-6

  // Metrics
  currentListeners Int @default(0)
  peakListeners    Int @default(0)
  totalSessions    Int @default(0)
  avgDuration      Int @default(0) // seconds

  // Engagement
  songRequests     Int @default(0)
  whatsappMessages Int @default(0)
  smsMessages      Int @default(0)

  // Program context
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  createdAt DateTime @default(now())

  @@unique([organizationId, timestamp])
  @@index([organizationId])
  @@index([timestamp])
  @@map("listener_metrics")
}

// ============================================
// WHATSAPP INTEGRATION (Organization-Scoped)
// ============================================

// WhatsApp Integration
model WhatsAppAccount {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // API credentials
  phoneNumberId     String // WhatsApp Business phone number ID
  phoneNumber       String // Actual phone number
  businessAccountId String

  // Status
  status     WhatsAppStatus @default(PENDING)
  isVerified Boolean        @default(false)

  // Limits
  messagingLimit  String? // TIER_1K, TIER_10K, TIER_100K
  monthlyMessages Int     @default(0)

  // Webhook
  webhookSecret String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_accounts")
}

enum WhatsAppStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

model WhatsAppMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Message details
  whatsappMessageId String           @unique // WhatsApp's message ID
  direction         MessageDirection

  // Sender/Recipient
  fromNumber  String
  toNumber    String
  contactName String?

  // Content
  messageType WhatsAppMessageType
  text        String?             @db.Text
  mediaUrl    String? // For images, audio, video
  caption     String?

  // Status
  status    WhatsAppMessageStatus
  timestamp DateTime

  // Conversation context
  conversationId   String?
  isReply          Boolean @default(false)
  replyToMessageId String?

  // Processing
  isProcessed     Boolean @default(false)
  processedAs     String? // SONG_REQUEST, CONTEST_ENTRY, etc.
  linkedRequestId String? // Link to ListenerRequest

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([fromNumber])
  @@index([conversationId])
  @@index([timestamp])
  @@map("whatsapp_messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  TEMPLATE
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  PENDING
}
