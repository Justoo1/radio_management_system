// ============================================
// ADVERTISING MANAGEMENT (Organization-Scoped)
// ============================================

// Daypart definitions for pricing tiers (e.g., Prime Time, Morning Drive)
model AdDaypart {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String // "Prime Time", "Morning Drive", "Overnight"
  startTime String // "HH:MM"
  endTime   String // "HH:MM"

  // Days of the week this daypart applies
  monday    Boolean @default(true)
  tuesday   Boolean @default(true)
  wednesday Boolean @default(true)
  thursday  Boolean @default(true)
  friday    Boolean @default(true)
  saturday  Boolean @default(true)
  sunday    Boolean @default(true)

  priceMultiplier Decimal @default(1.0) @db.Decimal(4, 2) // e.g., 1.5 for prime time
  isActive        Boolean @default(true)

  // Relations
  packages  AdPackage[]
  campaigns AdCampaign[] @relation("CampaignTargetDaypart")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("ad_dayparts")
}

// Advertising packages (e.g., "50 Play Package", "Prime Time Weekly")
model AdPackage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String // "50 Play Package", "Prime Time Weekly"
  description String? @db.Text

  packageType AdPackageType

  // For PLAY_COUNT type
  totalPlays Int? // e.g., 50 plays

  // For TIME_SLOT type
  durationDays Int? // e.g., 7 days
  playsPerDay  Int? // e.g., 5 plays per day

  // Pricing
  basePrice Decimal @db.Decimal(10, 2)
  currency  String  @default("GHS")

  // Optional restrictions
  daypartId String?
  daypart   AdDaypart? @relation(fields: [daypartId], references: [id])

  programId String?
  program   Program? @relation("PackageProgram", fields: [programId], references: [id])

  maxDuration Int     @default(60) // Max ad duration in seconds
  isActive    Boolean @default(true)

  // Relations
  campaigns AdCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([packageType])
  @@map("ad_packages")
}

enum AdPackageType {
  PLAY_COUNT // "50 plays for GH₵2000"
  TIME_SLOT // "5 plays/day for 7 days"
  PROGRAM_BASED // "During Morning Show only"
  DAYPART // "All prime time slots"
}

model AdCampaign {
  id String @id @default(cuid())

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  startDate DateTime
  endDate   DateTime

  budget      Decimal? @db.Decimal(10, 2)
  actualSpent Decimal? @db.Decimal(10, 2)

  status AdCampaignStatus @default(PENDING)

  // Package-based pricing
  packageId String?
  package   AdPackage? @relation(fields: [packageId], references: [id])

  // Scheduling mode
  scheduleType AdScheduleType @default(TIME_SLOT)

  // Play tracking
  targetPlays    Int? // Target number of plays from package
  completedPlays Int  @default(0) // Actual plays completed

  // Target constraints
  targetProgramId String?
  targetProgram   Program? @relation("CampaignTargetProgram", fields: [targetProgramId], references: [id])

  targetDaypartId String?
  targetDaypart   AdDaypart? @relation("CampaignTargetDaypart", fields: [targetDaypartId], references: [id])

  // Invoice integration
  invoiceId String?  @unique
  invoice   Invoice? @relation("CampaignInvoice", fields: [invoiceId], references: [id])

  // Fulfillment status
  fulfillmentStatus CampaignFulfillmentStatus @default(PENDING)

  // Relations
  advertisements Advertisement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([packageId])
  @@index([fulfillmentStatus])
  @@map("ad_campaigns")
}

enum AdCampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AdScheduleType {
  TIME_SLOT // Specific date/time slots
  FLEXIBLE // Play anytime within campaign dates
  PROGRAM_BASED // Only during specific program
  DAYPART_BASED // Only during specific daypart
}

enum CampaignFulfillmentStatus {
  PENDING // Not started
  IN_PROGRESS // Started playing
  ON_TRACK // Fulfillment on schedule
  BEHIND // Behind schedule
  COMPLETED // All plays delivered
  OVER_DELIVERED // More plays than target
}

model Advertisement {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  duration    Int // Duration in seconds

  mediaFileId String?
  mediaFile   MediaFile? @relation(fields: [mediaFileId], references: [id])

  // Scheduling
  slots      AdSlot[]
  totalPlays Int      @default(0)

  status AdStatus @default(ACTIVE)

  // Play history
  playHistory AdPlayHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([status])
  @@map("advertisements")
}

enum AdStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model AdSlot {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  scheduledTime String // Format: "HH:MM"

  wasPlayed Boolean   @default(false)
  playedAt  DateTime?

  notes String? @db.Text

  // Play history
  playHistory AdPlayHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertisementId])
  @@index([scheduledDate])
  @@index([wasPlayed])
  @@map("ad_slots")
}

// Detailed play history for analytics
model AdPlayHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  adSlotId String?
  adSlot   AdSlot? @relation(fields: [adSlotId], references: [id])

  playedAt     DateTime @default(now())
  playDuration Int // Actual seconds played

  // Program context
  programId String?
  program   Program? @relation("AdPlayProgram", fields: [programId], references: [id])

  // Presenter who played the ad
  presenterId String?
  presenter   User?   @relation("AdPlayPresenter", fields: [presenterId], references: [id])

  // Daypart context
  daypartName String?

  // Play status
  playStatus AdPlayStatus @default(COMPLETED)

  // Time context for analytics
  timeOfDay String? // "HH:MM"
  dayOfWeek Int? // 0-6

  notes String? @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([advertisementId])
  @@index([playedAt])
  @@index([programId])
  @@index([playStatus])
  @@map("ad_play_history")
}

enum AdPlayStatus {
  COMPLETED // Full play
  PARTIAL // Partially played
  SKIPPED // Manually skipped
  FAILED // Technical failure
}

// ============================================
// CONTRACTS & INVOICING (Organization-Scoped)
// ============================================

model Contract {
  id String @id @default(cuid())

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contractNumber String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  title       String
  description String? @db.Text

  startDate DateTime
  endDate   DateTime

  value Decimal @db.Decimal(10, 2)
  terms String? @db.Text

  status ContractStatus @default(DRAFT)

  // File attachments
  documentUrl       String?
  signedDocumentUrl String?

  // Relations
  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  signedAt  DateTime?

  @@unique([contractNumber, organizationId])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("contracts")
}

enum ContractStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

model Invoice {
  id String @id @default(cuid())

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoiceNumber String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])

  issueDate DateTime @default(now())
  dueDate   DateTime

  subtotal    Decimal  @db.Decimal(10, 2)
  taxAmount   Decimal? @db.Decimal(10, 2)
  discount    Decimal? @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)

  status InvoiceStatus @default(DRAFT)

  notes String? @db.Text

  // Relations
  items    InvoiceItem[]
  payments Payment[]

  // Ad Campaign (one-to-one)
  adCampaign AdCampaign? @relation("CampaignInvoice")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@unique([invoiceNumber, organizationId])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod

  referenceNumber String?
  notes           String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  CARD
  OTHER
}

