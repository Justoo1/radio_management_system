// Now playing history for streaming
model StreamNowPlayingHistory {
  id                String          @id @default(cuid())
  streamingConfigId String
  streamingConfig   StreamingConfig @relation(fields: [streamingConfigId], references: [id], onDelete: Cascade)

  // Song info
  title  String
  artist String?
  album  String?

  // Artwork
  artworkUrl String?

  // Timing
  playedAt DateTime @default(now())
  duration Int? // seconds

  // Source
  isLive       Boolean @default(false)
  djName       String?
  playlistName String?

  // Link to RMS Song (if matched)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  // Listeners at time of play
  listenersAtPlay Int?

  @@index([streamingConfigId])
  @@index([playedAt])
  @@index([songId])
  @@map("stream_now_playing_history")
