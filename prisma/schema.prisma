// ============================================
// LIVE ON-AIR MANAGEMENT (Organization-Scoped)
// ============================================

// Current playing item
model OnAirNow {
  id             String       @id @default(cuid())
  organizationId String       @unique // Only one item can be on-air per org
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // What's playing
  itemType OnAirItemType // SONG, AD, JINGLE, SEGMENT, VOICETRACK
  itemId   String? // Reference to Song, Advertisement, etc.
  title    String
  artist   String?
  duration Int // Duration in seconds

  // Timing
  startedAt        DateTime @default(now())
  endsAt           DateTime
  remainingSeconds Int // Updated in real-time

  // Metadata
  thumbnailUrl String?
  audioUrl     String?
  notes        String? @db.Text

  // Program context
  programId   String?
  program     Program? @relation(fields: [programId], references: [id])
  presenterId String
  presenter   User     @relation("OnAirPresenter", fields: [presenterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("on_air_now")
}

enum OnAirItemType {
  PROGRAM // Live broadcast program/show
  SONG
  AD
  JINGLE
  SEGMENT
  VOICETRACK
  TALK_BREAK
  STATION_ID
}

// Queue of upcoming items
model OnAirQueue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Queue item details
  itemType OnAirItemType
  itemId   String? // Reference to Song, Advertisement, etc.
  title    String
  artist   String?
  duration Int // Duration in seconds

  // Queue position
  position      Int // 1, 2, 3... (1 = next up)
  scheduledTime DateTime? // Optional specific time to play

  // Metadata
  thumbnailUrl String?
  audioUrl     String?
  notes        String? @db.Text

  // Status
  status     QueueItemStatus @default(QUEUED)
  playedAt   DateTime?
  skippedAt  DateTime?
  skipReason String?

  // Program context
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  // Auto-play control
  autoPlay Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, position])
  @@index([organizationId, status])
  @@map("on_air_queue")
}

enum QueueItemStatus {
  QUEUED // Waiting to play
  PLAYING // Currently playing
  PLAYED // Completed
  SKIPPED // Manually skipped
  FAILED // Technical error
}

// Songs/Tracks library
model Song {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Song details
  title    String
  artist   String
  album    String?
  genre    String?
  language String?

  // Audio file
  audioUrl String
  duration Int // Duration in seconds
  fileSize Int? // Size in bytes

  // Metadata
  releaseYear  Int?
  isrc         String? // International Standard Recording Code
  thumbnailUrl String?

  // Categorization
  mood  String? // Happy, Sad, Energetic, Calm, etc.
  tempo String? // Slow, Medium, Fast
  era   String? // 80s, 90s, 2000s, Current

  // Rotation category
  rotation SongRotation @default(MEDIUM)

  // Play tracking
  totalPlays   Int       @default(0)
  lastPlayedAt DateTime?

  // Restrictions
  isExplicit Boolean @default(false)
  isActive   Boolean @default(true)

  // Time-of-day restrictions (JSON)
  playRestrictions String? @db.Text // {"allowedHours": [6-22], "blockedDays": []}

  // Tags
  tags String? // JSON array of custom tags

  // Relations
  playHistory   SongPlayHistory[]
  playlistSongs PlaylistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([artist])
  @@index([genre])
  @@index([rotation])
  @@index([lastPlayedAt])
  @@map("songs")
}

enum SongRotation {
  POWER // High rotation - play frequently
  MEDIUM // Medium rotation
  LIGHT // Light rotation - play occasionally
  GOLD // Oldies/classics
  RECURRENT // Former hits, still popular
}

// Instant play buttons (jingles, sound effects, station IDs)
model InstantAudio {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Audio file
  audioUrl String
  duration Int // Duration in seconds

  // Type
  type     InstantAudioType
  category String? // e.g., "Sound Effects", "Station IDs"

  // Display
  buttonColor String? // Hex color for UI button
  icon        String? // Icon name
  position    Int // Order in dashboard (1, 2, 3...)

  // Hotkey
  hotkey String? // e.g., "F1", "Ctrl+1"

  // Play tracking
  totalPlays   Int       @default(0)
  lastPlayedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([position])
  @@map("instant_audio")
}

enum InstantAudioType {
  JINGLE
  SOUND_EFFECT
  STATION_ID
  SWEEPER
  PROMO
  LINER
}

// Listener requests (SMS/WhatsApp)
model ListenerRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Requester info
  listenerName  String?
  listenerPhone String
  listenerEmail String?

  // Request details
  requestType RequestType
  songTitle   String? // For song requests
  songArtist  String?
  message     String?     @db.Text // Dedication or general message

  // Source
  source RequestSource // SMS, WHATSAPP, PHONE, WEBSITE

  // Status
  status RequestStatus @default(PENDING)

  // Program context
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  // Actions
  playedAt    DateTime?
  readOnAirAt DateTime?

  // Notes from presenter
  presenterNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([listenerPhone])
  @@index([createdAt])
  @@map("listener_requests")
}

enum RequestType {
  SONG_REQUEST
  DEDICATION
  SHOUTOUT
  QUESTION
  COMMENT
  CONTEST_ENTRY
}

enum RequestSource {
  SMS
  WHATSAPP
  PHONE
  WEBSITE
  MOBILE_APP
  SOCIAL_MEDIA
}

enum RequestStatus {
  PENDING
  APPROVED
  PLAYED
  READ_ON_AIR
  REJECTED
  SPAM
}

// Show notes for presenters
model ShowNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Program context
  programId   String?
  program     Program? @relation(fields: [programId], references: [id])
  presenterId String
  presenter   User     @relation("ShowNotePresenter", fields: [presenterId], references: [id])

  // Note details
  noteType ShowNoteType
  title    String?
  content  String       @db.Text

  // Timing
  showDate   DateTime
  timeMarker String? // e.g., "12:30 PM" - when to mention

  // Status
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  // Priority
  priority NotePriority @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([programId])
  @@index([presenterId])
  @@index([showDate])
  @@map("show_notes")
}

enum ShowNoteType {
  REMINDER
  TALKING_POINT
  SPONSOR_READ
  GUEST_INFO
  CONTEST_DETAIL
  WEATHER
  TRAFFIC
  NEWS_ITEM
  TECHNICAL_NOTE
}

enum NotePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Smart playlists
model Playlist {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Type
  type PlaylistType

  // Smart playlist rules (JSON)
  rules String? @db.Text // {"genre": ["Pop", "Rock"], "rotation": ["POWER"]}

  // Manual playlist songs
  songs PlaylistSong[]

  // Settings
  shuffle       Boolean @default(false)
  avoidRepeats  Boolean @default(true)
  repeatMinutes Int     @default(120) // Don't repeat songs within X minutes

  // Scheduling
  timeRestrictions String? @db.Text // {"allowedHours": [6-22]}

  // Usage
  totalPlays Int       @default(0)
  lastUsedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@map("playlists")
}

enum PlaylistType {
  MANUAL // Manually curated
  SMART // Auto-generated based on rules
  TIME_BASED // Morning, Afternoon, Evening
  DAY_BASED // Monday Mix, Friday Favorites
  MOOD_BASED // Upbeat, Chill, Energetic
}

model PlaylistSong {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  position Int // Order in playlist

  addedAt DateTime @default(now())

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@map("playlist_songs")
}

// Song play history (for clash detection)
model SongPlayHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id])

  playedAt DateTime @default(now())

  // Context
  programId   String?
  program     Program? @relation(fields: [programId], references: [id])
  presenterId String?
  presenter   User?    @relation("SongPlayPresenter", fields: [presenterId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, playedAt])
  @@index([songId, playedAt])
  @@map("song_play_history")
}

// ============================================
// LISTENER ANALYTICS (Organization-Scoped)
