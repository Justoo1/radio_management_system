// ============================================
// LIVE ON-AIR MANAGEMENT (Organization-Scoped)
// ============================================

// Current playing item
model OnAirNow {
  id             String       @id @default(cuid())
  organizationId String       @unique // Only one item can be on-air per org
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // What's playing
  itemType OnAirItemType // SONG, AD, JINGLE, SEGMENT, VOICETRACK
  itemId   String? // Reference to Song, Advertisement, etc.
  title    String
  artist   String?
  duration Int // Duration in seconds

  // Timing
  startedAt        DateTime @default(now())
  endsAt           DateTime
  remainingSeconds Int // Updated in real-time

  // Metadata
  thumbnailUrl String?
  audioUrl     String?
  notes        String? @db.Text

  // Program context
  programId   String?
  program     Program? @relation(fields: [programId], references: [id])
  presenterId String
  presenter   User     @relation("OnAirPresenter", fields: [presenterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("on_air_now")
}

enum OnAirItemType {
  PROGRAM // Live broadcast program/show
  SONG
  AD
  JINGLE
  SEGMENT
  VOICETRACK
  TALK_BREAK
  STATION_ID
}

// Queue of upcoming items
model OnAirQueue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Queue item details
  itemType OnAirItemType
  itemId   String? // Reference to Song, Advertisement, etc.
  title    String
  artist   String?
  duration Int // Duration in seconds

  // Queue position
  position      Int // 1, 2, 3... (1 = next up)
  scheduledTime DateTime? // Optional specific time to play

  // Metadata
  thumbnailUrl String?
  audioUrl     String?
  notes        String? @db.Text

  // Status
  status     QueueItemStatus @default(QUEUED)
  playedAt   DateTime?
  skippedAt  DateTime?
  skipReason String?

  // Program context
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  // Auto-play control
  autoPlay Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, position])
  @@index([organizationId, status])
  @@map("on_air_queue")
}

enum QueueItemStatus {
  QUEUED // Waiting to play
  PLAYING // Currently playing
  PLAYED // Completed
  SKIPPED // Manually skipped
  FAILED // Technical error
}

// Songs/Tracks library
model Song {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Song details
  title    String
  artist   String
  album    String?
  genre    String?
  language String?

  // Audio file
  audioUrl String
  duration Int // Duration in seconds
  fileSize Int? // Size in bytes

  // Metadata
  releaseYear  Int?
  isrc         String? // International Standard Recording Code
  thumbnailUrl String?

  // Categorization
  mood  String? // Happy, Sad, Energetic, Calm, etc.
  tempo String? // Slow, Medium, Fast
  era   String? // 80s, 90s, 2000s, Current

  // Rotation category
  rotation SongRotation @default(MEDIUM)

  // Play tracking
  totalPlays   Int       @default(0)
  lastPlayedAt DateTime?

  // Restrictions
  isExplicit Boolean @default(false)
  isActive   Boolean @default(true)

  // Time-of-day restrictions (JSON)
  playRestrictions String? @db.Text // {"allowedHours": [6-22], "blockedDays": []}

  // Tags
  tags String? // JSON array of custom tags

  // Relations
  playHistory   SongPlayHistory[]
  playlistSongs PlaylistSong[]

  // Streaming now playing history
  streamNowPlayingHistory StreamNowPlayingHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([artist])
  @@index([genre])
  @@index([rotation])
  @@index([lastPlayedAt])
  @@map("songs")
}

enum SongRotation {
  POWER // High rotation - play frequently
  MEDIUM // Medium rotation
  LIGHT // Light rotation - play occasionally
  GOLD // Oldies/classics
  RECURRENT // Former hits, still popular
}

// Instant play buttons (jingles, sound effects, station IDs)
