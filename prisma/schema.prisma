// ============================================
// STREAMING (Online Broadcasting - AzuraCast Integration)
// ============================================

// Per-organization streaming configuration
model StreamingConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Status
  isEnabled Boolean      @default(false)
  status    StreamStatus @default(INACTIVE)

  // AzuraCast Integration
  azuracastStationId Int?
  azuracastApiKey    String? @db.Text // Encrypted, station-specific API key

  // Stream Details
  streamName        String?
  streamDescription String? @db.Text
  streamGenre       String?
  streamUrl         String? // Public stream URL
  streamMountPoint  String? // e.g., /radio.mp3

  // Limits (from plan, cached for quick access)
  maxListeners   Int @default(100)
  maxBitrate     Int @default(128) // kbps
  storageQuotaMB Int @default(10240) // 10GB default
  storageUsedMB  Int @default(0)

  // Branding
  logoUrl           String?
  playerAccentColor String? @default("#3B82F6")

  // Metadata
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSyncAt DateTime?

  // Relations
  mountPoints       StreamMountPoint[]
  djAccounts        StreamDJAccount[]
  playlists         StreamPlaylist[]
  analytics         StreamAnalytics[]
  listenerSessions  StreamListenerSession[]
  nowPlayingHistory StreamNowPlayingHistory[]

  @@index([organizationId])
  @@index([status])
  @@map("streaming_configs")
}

enum StreamStatus {
  INACTIVE // Not set up
  CONFIGURING // Setup in progress
  ACTIVE // Live and running
  OFFLINE // Configured but not streaming
  ERROR // Configuration error
  SUSPENDED // Suspended due to plan/payment
}

// Stream mount points (quality options)
model StreamMountPoint {
  id                String          @id @default(cuid())
  streamingConfigId String
  streamingConfig   StreamingConfig @relation(fields: [streamingConfigId], references: [id], onDelete: Cascade)

  azuracastMountId Int? // ID in AzuraCast for syncing

  name       String // e.g., "High Quality", "Low Bandwidth"
  mountPoint String // e.g., /radio-hq.mp3
  url        String // Full URL
  format     StreamFormat @default(MP3)
  bitrate    Int // kbps
  isDefault  Boolean      @default(false)

  createdAt DateTime @default(now())

  @@unique([streamingConfigId, mountPoint])
  @@index([streamingConfigId])
  @@map("stream_mount_points")
}

enum StreamFormat {
  MP3
  AAC
  OGG
  OPUS
  FLAC
}

// DJ / Source accounts for live broadcasting
model StreamDJAccount {
  id                String          @id @default(cuid())
  streamingConfigId String
  streamingConfig   StreamingConfig @relation(fields: [streamingConfigId], references: [id], onDelete: Cascade)

  userId String? // Link to RMS user (optional)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  username    String
  password    String // Hashed

  isActive     Boolean @default(true)
  canBroadcast Boolean @default(true)

  // Connection details (provided by AzuraCast)
  sourceHost       String?
  sourcePort       Int?
  sourceMountPoint String?

  // AzuraCast reference
  azuracastStreamerId Int?

  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Remote Airtime Booking relation
  airtimeBooking AirtimeBooking?

  @@unique([streamingConfigId, username])
  @@index([streamingConfigId])
  @@index([userId])
  @@map("stream_dj_accounts")
}

// Streaming playlists (AutoDJ)
model StreamPlaylist {
  id                String          @id @default(cuid())
  streamingConfigId String
  streamingConfig   StreamingConfig @relation(fields: [streamingConfigId], references: [id], onDelete: Cascade)

  azuracastPlaylistId Int? // ID in AzuraCast

  name      String
  type      StreamPlaylistType @default(DEFAULT)
  isEnabled Boolean            @default(true)

  // Scheduling
  playOrder PlaylistOrder @default(SHUFFLE)
  weight    Int           @default(3) // 1-25, higher = more frequent

  // Time-based scheduling (optional)
  scheduledStartTime String? // HH:MM format
  scheduledEndTime   String? // HH:MM format
  scheduledDays      String? // JSON array: [0,1,2,3,4,5,6] (Sun-Sat)

  // Link to RMS Program (optional)
  programId String?
  program   Program? @relation("StreamPlaylistProgram", fields: [programId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs StreamPlaylistSong[]

  @@index([streamingConfigId])
  @@index([programId])
  @@map("stream_playlists")
}

enum StreamPlaylistType {
  DEFAULT // General rotation
  SCHEDULED // Time-based
  ONCE_PER_HOUR // Play once per hour
  ONCE_PER_DAY // Play once per day
  JINGLES // Station IDs, jingles
  REQUESTS // Listener requests
}

enum PlaylistOrder {
  SHUFFLE // Random
  SEQUENTIAL // In order
  WEIGHTED // Based on song weight
}

model StreamPlaylistSong {
  id         String         @id @default(cuid())
  playlistId String
  playlist   StreamPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  // Link to RMS MediaFile or AzuraCast media
  mediaFileId      String?
  mediaFile        MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  azuracastMediaId Int?

  title    String
  artist   String?
  duration Int? // seconds
  weight   Int     @default(1)

  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([playlistId])
  @@index([mediaFileId])
  @@map("stream_playlist_songs")
}

// Streaming analytics (aggregated metrics)
model StreamAnalytics {
  id                String          @id @default(cuid())
  streamingConfigId String
  streamingConfig   StreamingConfig @relation(fields: [streamingConfigId], references: [id], onDelete: Cascade)

  // Time period
  timestamp  DateTime
  periodType AnalyticsPeriod @default(HOURLY)

  // Listener metrics
  listenersMin    Int   @default(0)
  listenersMax    Int   @default(0)
  listenersAvg    Float @default(0)
  uniqueListeners Int   @default(0)

  // Engagement metrics
  totalListeningMinutes Int   @default(0)
  avgListeningDuration  Float @default(0) // minutes

  // Geographic data (JSON)
  listenersByCountry Json? // { "GH": 150, "US": 25, ... }
  listenersByCity    Json? // { "Accra": 100, "Kumasi": 50, ... }

  // Device/Platform data (JSON)
  listenersByPlatform Json? // { "web": 100, "mobile": 50, "app": 25 }
  listenersByPlayer   Json? // { "browser": 80, "vlc": 20, ... }

  // Content played
  songsPlayed Int @default(0)

  createdAt DateTime @default(now())

  @@unique([streamingConfigId, timestamp, periodType])
  @@index([streamingConfigId])
  @@index([timestamp])
  @@index([periodType])
  @@map("stream_analytics")
}

enum AnalyticsPeriod {
  REALTIME // Current snapshot
  HOURLY // Aggregated by hour
  DAILY // Aggregated by day
  WEEKLY // Aggregated by week
  MONTHLY // Aggregated by month
}

// Online listener sessions
model StreamListenerSession {
  id                String          @id @default(cuid())
  streamingConfigId String
  streamingConfig   StreamingConfig @relation(fields: [streamingConfigId], references: [id], onDelete: Cascade)

  // Session info
  sessionId String @unique // From AzuraCast or generated

  // Listener identification
  ipAddress String?
  userAgent String?

  // Geographic info
  country     String?
  countryCode String?
  city        String?
  region      String?

  // Device info
  deviceType String? // desktop, mobile, tablet
  browser    String?
  os         String?
  player     String? // web, vlc, winamp, etc.

  // Mount point used
  mountPoint String?

  // Timing
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  // Quality
  bytesTransferred BigInt?

  @@index([streamingConfigId])
  @@index([startedAt])
  @@index([countryCode])
  @@map("stream_listener_sessions")
