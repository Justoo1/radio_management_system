generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY - ORGANIZATION MANAGEMENT
// ============================================

model Organization {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique // URL-friendly identifier (e.g., "joy-fm")
  subdomain String? @unique // Optional custom subdomain

  // Business Information
  email    String
  phone    String?
  address  String?
  city     String?
  region   String?
  country  String  @default("Ghana")
  currency String  @default("GHS") // ISO 4217 currency code (GHS for Ghana Cedis)
  website  String?
  logo     String?

  // Registration & Business Details
  businessType       BusinessType @default(RADIO_STATION)
  registrationNumber String?
  taxId              String?

  // Paystack Subaccount (for Airtime Payments)
  paystackSubaccountId   String? // Paystack subaccount ID
  paystackSubaccountCode String? // Paystack subaccount code
  settlementType         String? // "bank" or "mobile_money"
  // Bank Details
  bankName       String?
  accountNumber  String?
  accountName    String?
  bankCode       String? // Paystack bank code
  // Mobile Money Details
  momoProvider String? // "mtn", "vod", "tgo"
  momoNumber   String?
  momoName     String?
  // Subaccount Setup Status
  hasPaymentAccount Boolean @default(false)

  // Subscription & Status
  subscriptionId String?            @unique
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id])
  status         OrganizationStatus @default(TRIAL)

  // Trial Management
  trialStartDate DateTime @default(now())
  trialEndDate   DateTime // Auto-set to 7 days from creation
  isTrialUsed    Boolean  @default(false)

  // Feature Limits (based on plan)
  maxUsers       Int @default(5)
  maxClients     Int @default(100)
  maxSMSPerMonth Int @default(500)
  maxStorageGB   Int @default(5)
  maxPrograms    Int @default(50)

  // Feature Flags (Admin can lock/unlock features)
  enabledFeatures String @default("[]") @db.Text // JSON array of enabled feature keys

  // Owner
  ownerId String? @unique
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  // Relations
  users          User[]                @relation("OrganizationUsers")
  roles          Role[]
  teams          Team[]                @relation("OrganizationTeams")
  clients        Client[]
  programs       Program[]
  smsCampaigns   SMSCampaign[]
  smsTemplates   SMSTemplate[]         @relation("OrganizationSMSTemplates")
  smsContacts    SMSContact[]
  mediaFiles     MediaFile[]
  adCampaigns    AdCampaign[]
  adDayparts     AdDaypart[]
  adPackages     AdPackage[]
  adPlayHistory  AdPlayHistory[]
  contracts      Contract[]
  invoices       Invoice[]
  expenses       Expense[]             @relation("OrganizationExpenses")
  bills          Bill[]                @relation("OrganizationBills")
  communications Communication[]
  activityLogs   ActivityLog[]
  metrics        Metric[]              @relation("OrganizationMetrics")
  settings       OrganizationSetting[]

  // Live On-Air
  onAirNow         OnAirNow?
  onAirQueue       OnAirQueue[]
  songs            Song[]
  instantAudios    InstantAudio[]
  listenerRequests ListenerRequest[]
  showNotes        ShowNote[]
  playlists        Playlist[]
  songPlayHistory  SongPlayHistory[]

  // Analytics
  listenerSessions   ListenerSession[]
  engagementSessions EngagementSession[]
  listenerMetrics    ListenerMetrics[]
  programRatings     ProgramRating[]

  // WhatsApp
  whatsappAccount WhatsAppAccount?

  // Listener Chat
  listenerChatMessages ListenerChatMessage[]
  whatsappMessages     WhatsAppMessage[]

  // Push Notifications
  pushSubscriptions PushSubscription[]

  // Streaming (Online Broadcasting)
  streamingConfig StreamingConfig?

  // Remote Airtime Booking
  airtimePackages AirtimePackage[]
  airtimeBookings AirtimeBooking[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  suspendedAt DateTime?
  deletedAt   DateTime? // Soft delete

  @@index([slug])
  @@index([status])
  @@index([ownerId])
  @@map("organizations")
}

enum OrganizationStatus {
  TRIAL // 7-day trial period
  ACTIVE // Paid and active
  SUSPENDED // Payment failed or overdue
  CANCELLED // Subscription cancelled
  EXPIRED // Trial expired without payment
}

enum BusinessType {
  RADIO_STATION
  PODCAST_NETWORK
  MEDIA_COMPANY
  OTHER
}

// ============================================
// SUBSCRIPTION & BILLING MANAGEMENT
// ============================================

model Subscription {
  id           String        @id @default(cuid())
  organization Organization?

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  // Billing Period
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  // Cancellation
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  // Payment tracking
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?

  // Relations
  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING // 7-day trial
  ACTIVE // Paid subscription
  PAST_DUE // Payment failed, grace period
  CANCELLED // User cancelled
  EXPIRED // Trial or subscription ended
}

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "Starter", "Professional", "Enterprise"
  description String? @db.Text

  // Pricing
  price           Decimal         @db.Decimal(10, 2) // Monthly price in GHS
  currency        String          @default("GHS")
  billingInterval BillingInterval @default(MONTHLY)

  // Feature Limits
  maxUsers       Int @default(5)
  maxClients     Int @default(100)
  maxSMSPerMonth Int @default(500)
  maxStorageGB   Int @default(5)
  maxPrograms    Int @default(50)

  // Features
  features String @db.Text // JSON array of features

  // Streaming Features (Online Broadcasting)
  streamingEnabled             Boolean @default(false)
  maxStreamListeners           Int     @default(0)
  streamStorageGB              Int     @default(0)
  maxStreamBitrate             Int     @default(128) // kbps
  maxStreamPlaylists           Int     @default(5)
  streamAnalyticsRetentionDays Int     @default(30)
  customStreamBranding         Boolean @default(false)

  // Display
  isPopular Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // Relations
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("GHS")

  // Payment Details
  status        PaymentStatus     @default(PENDING)
  paymentMethod PaymentMethodType
  provider      PaymentProvider // HUBTEL or STRIPE

  // Provider References
  providerPaymentId  String? @unique // Hubtel transaction ID or Stripe payment intent ID
  providerCustomerId String? // For Stripe customer ID

  // Hubtel Specific
  mobileNumber String? // For mobile money payments
  network      MobileMoneyNetwork?

  // Stripe Specific
  stripePaymentIntentId String?
  stripeInvoiceId       String?

  // Metadata
  description String?
  metadata    String? @db.Text // JSON for additional data

  // Tracking
  attemptCount  Int     @default(1)
  failureReason String? @db.Text

  paidAt   DateTime?
  failedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("subscription_payments")
}

// Monthly Bills for Organizations
model Bill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationBills", fields: [organizationId], references: [id], onDelete: Cascade)

  // Billing Period
  billingMonth Int // 1-12
  billingYear  Int

  // Amount
  amount      Decimal @db.Decimal(10, 2)
  currency    String  @default("GHS")
  description String? @db.Text

  // Status
  status  BillStatus @default(PENDING)
  dueDate DateTime
  paidAt  DateTime?

  // Payment Reference
  paymentMethod PaymentMethodType?
  paymentRef    String? // Reference number from customer
  notes         String?            @db.Text

  // Reminders
  reminderSentAt      DateTime?
  overdueNoticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, billingMonth, billingYear])
  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("bills")
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethodType {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentProvider {
  HUBTEL
  STRIPE
  PAYSTACK
}

enum MobileMoneyNetwork {
  MTN
  VODAFONE
  AIRTELTIGO
}

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  password      String // Hashed password
  name          String?
  phone         String?
  image         String?
  status        UserStatus @default(ACTIVE)

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: Cascade)

  // Organization ownership (only one user per org)
  ownedOrganization Organization? @relation("OrganizationOwner")

  // Role within the organization
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Invitation tracking (for team members)
  invitedById String?
  invitedAt   DateTime?
  acceptedAt  DateTime?

  // Relations
  accounts       Account[]
  sessions       Session[]
  programs       Program[]     @relation("ProgramHost")
  mediaFiles     MediaFile[]
  smsCampaigns   SMSCampaign[]
  createdClients Client[]      @relation("CreatedBy")
  activityLogs   ActivityLog[]

  // Team Relations
  teamsLed     Team[]       @relation("TeamLead")
  teamsCreated Team[]       @relation("CreatedTeam")
  teamMembers  TeamMember[] @relation("TeamMember")

  // Live On-Air
  onAirSessions OnAirNow[]        @relation("OnAirPresenter")
  showNotes     ShowNote[]        @relation("ShowNotePresenter")
  songPlays     SongPlayHistory[] @relation("SongPlayPresenter")

  // Advertising
  adPlayHistory AdPlayHistory[] @relation("AdPlayPresenter")

  // Listener Chat Moderation
  moderatedChatMessages ListenerChatMessage[] @relation("ChatMessageModerator")

  // Engagement Sessions
  engagementSessions EngagementSession[]

  // Push Notifications
  pushSubscriptions PushSubscription[]

  // Streaming DJ Accounts
  streamDJAccounts StreamDJAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
  @@index([email])
  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_INVITATION
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web Push subscription data
  endpoint String @unique @db.Text
  p256dh   String @db.Text // Public key
  auth     String // Auth secret

  // Device info
  userAgent  String? @db.Text
  deviceName String?

  // Notification preferences
  notifyRequests Boolean @default(true)
  notifyChat     Boolean @default(true)
  notifyPayments Boolean @default(true)
  notifySystem   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@map("push_subscriptions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// ROLE-BASED ACCESS CONTROL (Organization-Scoped)
// ============================================

model Role {
  id          String  @id @default(cuid())
  name        String // e.g., OWNER, ADMIN, PROGRAM_MANAGER, SALES_MANAGER, HOST, VIEWER
  displayName String // User-friendly name
  description String?

  // Multi-tenant - Roles are scoped to organizations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isSystemRole Boolean      @default(false) // true for default roles (OWNER, ADMIN)
  permissions  Permission[]
  users        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // e.g., "clients.create", "programs.edit", "sms.send"
  resource    String // e.g., "clients", "programs", "sms"
  action      String // e.g., "create", "read", "update", "delete"
  description String?
  roles       Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resource, action])
  @@map("permissions")
}

// ============================================
// TEAM MANAGEMENT (Organization-Scoped)
// ============================================

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationTeams", fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Team type: PROGRAM_TEAM, ENGINEERING, SALES, OPERATIONS, etc.
  teamType TeamType

  // Team lead (usually a user with TEAM_LEAD role)
  teamLeadId String?
  teamLead   User?   @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)

  // Who created this team
  createdById String
  createdBy   User   @relation("CreatedTeam", fields: [createdById], references: [id], onDelete: Cascade)

  // Status
  status   TeamStatus @default(ACTIVE)
  isActive Boolean    @default(true)

  // Relations
  members  TeamMember[]
  programs Program[]    @relation("TeamPrograms")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([teamLeadId])
  @@index([teamType])
  @@index([status])
  @@map("teams")
}

enum TeamType {
  PROGRAM_TEAM
  ENGINEERING
  SALES
  OPERATIONS
  MARKETING
  CONTENT
  MANAGEMENT
  OTHER
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TeamMember", fields: [userId], references: [id], onDelete: Cascade)

  // Role within team (different from organization role)
  role TeamMemberRole @default(MEMBER)

  // Responsibility
  title String? // e.g., "Producer", "Sound Engineer", "Host"
  bio   String? @db.Text

  // When joined
  joinedAt DateTime @default(now())

  // Can manage team?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

enum TeamMemberRole {
  LEAD
  MANAGER
  MEMBER
  VIEWER
}

// ============================================
// CLIENT MANAGEMENT (Organization-Scoped)
// ============================================

model Client {
  id String @id @default(cuid())

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  email          String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  region         String?
  website        String?

  categoryId String?
  category   ClientCategory? @relation(fields: [categoryId], references: [id])

  taxId          String? // TIN or VAT number
  registrationNo String? // Business registration number
  notes          String?      @db.Text
  status         ClientStatus @default(ACTIVE)

  // Relations
  contactPersons ContactPerson[]
  contracts      Contract[]
  adCampaigns    AdCampaign[]
  invoices       Invoice[]
  communications Communication[]

  // Audit fields
  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, organizationId]) // Email unique per organization
  @@index([organizationId])
  @@index([phone])
  @@index([categoryId])
  @@index([status])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  CHURNED
}

model ClientCategory {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Advertiser", "Sponsor", "Partner", "Government", "Corporate"
  description String?
  color       String? // For UI display
  clients     Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_categories")
}

model ContactPerson {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  position  String? // e.g., "Marketing Manager", "CEO"
  email     String?
  phone     String?
  isPrimary Boolean @default(false)
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("contact_persons")
}

// ============================================
// PROGRAM MANAGEMENT (Organization-Scoped)
// ============================================

model Program {
  id String @id @default(cuid())

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  description    String? @db.Text
  genre          String? // e.g., "News", "Music", "Talk Show", "Sports"
  language       String? // e.g., "English", "Twi", "Ga"
  targetAudience String? // e.g., "Youth", "Adults", "General"

  duration Int // Duration in minutes
  isActive Boolean @default(true)

  // Program Status/Lifecycle
  status ProgramStatus @default(DRAFT)

  // Host/Presenter
  hostId  String?
  host    User?   @relation("ProgramHost", fields: [hostId], references: [id])
  coHosts String? // JSON array of co-host names

  // Team Management
  teamId String?
  team   Team?   @relation("TeamPrograms", fields: [teamId], references: [id], onDelete: SetNull)

  // Media
  thumbnailUrl  String?
  promoAudioUrl String?

  // Relations
  schedules ProgramSchedule[]
  episodes  ProgramEpisode[]

  // Live On-Air
  onAirSessions      OnAirNow[]
  queueItems         OnAirQueue[]
  listenerRequests   ListenerRequest[]
  showNotes          ShowNote[]
  songPlayHistory    SongPlayHistory[]
  listenerSessions   ListenerSession[]
  engagementSessions EngagementSession[]
  listenerMetrics    ListenerMetrics[]
  ratings            ProgramRating[]

  // Advertising
  adPackages      AdPackage[]     @relation("PackageProgram")
  adPlayHistory   AdPlayHistory[] @relation("AdPlayProgram")
  targetCampaigns AdCampaign[]    @relation("CampaignTargetProgram")

  // Streaming playlists
  streamPlaylists StreamPlaylist[] @relation("StreamPlaylistProgram")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([hostId])
  @@index([teamId])
  @@index([isActive])
  @@index([status])
  @@map("programs")
}

enum ProgramStatus {
  DRAFT // Planning stage, not yet scheduled
  SCHEDULED // Scheduled for broadcast
  LIVE // Currently broadcasting
  ARCHIVED // Past broadcasts
  CANCELLED // Cancelled/not airing
}

model ProgramSchedule {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String // Format: "HH:MM" (24-hour format)
  endTime   String // Format: "HH:MM" (24-hour format)

  isRecurring Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?

  isActive Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("program_schedules")
}

model ProgramEpisode {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  episodeNumber Int?
  title         String
  description   String? @db.Text

  airDate  DateTime
  duration Int? // Duration in minutes

  audioFileUrl String?
  transcript   String? @db.Text

  guestNames String? // JSON array of guest names
  topics     String? // JSON array of topics discussed

  status EpisodeStatus @default(SCHEDULED)
  notes  String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([airDate])
  @@index([status])
  @@map("program_episodes")
}

enum EpisodeStatus {
  SCHEDULED
  RECORDED
  AIRED
  CANCELLED
}

// ============================================
// SMS MANAGEMENT (Organization-Scoped)
// ============================================

model SMSCampaign {
  id String @id @default(cuid())

  // Multi-tenant relationship
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Message content
  templateId     String?
  template       SMSTemplate? @relation(fields: [templateId], references: [id])
  messageContent String       @db.Text

  // Targeting
  recipientType   RecipientType // ALL, CATEGORY, CUSTOM, IMPORTED
  recipientFilter String? // JSON filter criteria
  totalRecipients Int           @default(0)

  // Scheduling
  scheduledAt     DateTime?
  sendImmediately Boolean   @default(false)

  // Status tracking
  status         CampaignStatus @default(DRAFT)
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  failedCount    Int            @default(0)

  // Cost tracking
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)

  // Relations
  messages SMSMessage[]

  // Audit
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  completedAt DateTime?

  @@index([organizationId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdById])
  @@map("sms_campaigns")
}

enum RecipientType {
  ALL // All clients
  CATEGORY // By client category
  CUSTOM // Custom selection
  IMPORTED // CSV import
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  PARTIALLY_SENT
  COMPLETED
  FAILED
  CANCELLED
}

model SMSMessage {
  id         String       @id @default(cuid())
  campaignId String?
  campaign   SMSCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  recipient     String // Phone number
  recipientName String?
  message       String  @db.Text

  // Status tracking
  status      MessageStatus @default(PENDING)
  sentAt      DateTime?
  deliveredAt DateTime?

  // Gateway response
  gatewayMessageId String?
  gatewayResponse  String? @db.Text
  errorMessage     String? @db.Text

  // Cost
  cost Decimal? @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([recipient])
  @@index([sentAt])
  @@map("sms_messages")
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  REJECTED
}

model SMSTemplate {
