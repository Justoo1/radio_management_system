enum InstantAudioType {
  JINGLE
  SOUND_EFFECT
  STATION_ID
  SWEEPER
  PROMO
  LINER
}

// Listener requests (SMS/WhatsApp)
model ListenerRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Requester info
  listenerName  String?
  listenerPhone String
  listenerEmail String?

  // Request details
  requestType RequestType
  songTitle   String? // For song requests
  songArtist  String?
  message     String?     @db.Text // Dedication or general message

